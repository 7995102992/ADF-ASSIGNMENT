{
	"name": "PL_Metadata_Driven_Load",
	"properties": {
		"activities": [
			{
				"name": "GetEntityConfig",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT * FROM meta.EntityConfig WHERE EntityId = ', string(pipeline().parameters.EntityId))",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference",
						"parameters": {
							"p_Schema": {
								"value": "meta",
								"type": "Expression"
							},
							"p_Table": {
								"value": "EntityConfig",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "GetFiles",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "GetEntityConfig",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_Dynamic_Source",
						"type": "DatasetReference",
						"parameters": {
							"p_FileName": {
								"value": "*",
								"type": "Expression"
							},
							"p_Container": {
								"value": "@activity('GetEntityConfig').output.firstRow.SourceContainer",
								"type": "Expression"
							},
							"p_Directory": {
								"value": "@activity('GetEntityConfig').output.firstRow.SourcePathPattern",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "ForEachFile",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GetFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetFiles').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "CopyFileToStaging",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"preCopyScript": {
										"value": "@concat('TRUNCATE TABLE ', activity('GetEntityConfig').output.firstRow.StagingTable)",
										"type": "Expression"
									},
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_ADLS_Dynamic_Source",
									"type": "DatasetReference",
									"parameters": {
										"p_FileName": {
											"value": "@item().name",
											"type": "Expression"
										},
										"p_Container": {
											"value": "@activity('GetEntityConfig').output.firstRow.SourceContainer",
											"type": "Expression"
										},
										"p_Directory": {
											"value": "@activity('GetEntityConfig').output.firstRow.SourcePathPattern",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "AzureSqlTable1",
									"type": "DatasetReference",
									"parameters": {
										"p_Schema": {
											"value": "stg",
											"type": "Expression"
										},
										"p_Table": {
											"value": "@replace(activity('GetEntityConfig').output.firstRow.StagingTable, 'stg.', '')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "ExecuteTargetLoadAndDeduplication",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "GetNewWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dw].[usp_LoadFactSales]"
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "GetNewWatermark",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "ForEachFile",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@if(\n    empty(activity('GetEntityConfig').output.firstRow.WatermarkColumn),\n    'SELECT CONVERT(VARCHAR(30), GETUTCDATE(), 126) AS NewWatermarkValue',\n    concat('SELECT CONVERT(VARCHAR(30), ISNULL(MAX(', activity('GetEntityConfig').output.firstRow.WatermarkColumn, '), ''', coalesce(activity('GetEntityConfig').output.firstRow.LastWatermarkValue, '1900-01-01'), '''), 126) AS NewWatermarkValue FROM ', activity('GetEntityConfig').output.firstRow.StagingTable)\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference",
						"parameters": {
							"p_Schema": "stg",
							"p_Table": "SalesOrder"
						}
					}
				}
			},
			{
				"name": "UpdateWatermarkValue",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "ExecuteTargetLoadAndDeduplication",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[meta].[usp_UpdateWatermark]",
					"storedProcedureParameters": {
						"EntityId": {
							"value": {
								"value": "@pipeline().parameters.EntityId",
								"type": "Expression"
							},
							"type": "Int32"
						},
						"NewWatermark": {
							"value": {
								"value": "@activity('GetNewWatermark').output.firstRow.NewWatermarkValue",
								"type": "Expression"
							},
							"type": "DateTime"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"EntityId": {
				"type": "int"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-08-21T13:52:04Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}