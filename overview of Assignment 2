    EntityId            INT IDENTITY(1,1) PRIMARY KEY,
    SourceSystemId      INT NOT NULL REFERENCES meta.SourceSystem(SourceSystemId),
    EntityName          NVARCHAR(100) NOT NULL,
    EntityType          NVARCHAR(20)  NOT NULL,          -- 'Dimension' / 'Fact'
    SourceContainer     NVARCHAR(100) NOT NULL,          -- 'raw'
    SourcePathPattern   NVARCHAR(500) NOT NULL,          -- 'sales/orders/{yyyy}/{MM}/{dd}/'
    SourceFileFormat    NVARCHAR(20)  NOT NULL,          -- 'csv' / 'parquet' / 'json'
