2. STORED PROCEDURES & TRANSFORMATION LOGIC
--------------------------------------------------------------------------------

2.1 Deduplication Stored Procedure
--------------------------------------------------------------------------------
CREATE OR ALTER PROCEDURE stg.usp_DeduplicateSalesOrder
AS
BEGIN
    SET NOCOUNT ON;
    
    WITH RankedOrders AS (
        SELECT *,
               ROW_NUMBER() OVER (
                   PARTITION BY OrderId, LineNumber 
                   ORDER BY LoadTimestamp DESC
               ) AS rn
        FROM stg.SalesOrder
    )
    INSERT INTO stg.DuplicateLog (EntityName, BusinessKey, RowData, DetectedOn)
    SELECT 'SalesOrder',
           CONCAT(OrderId, '|', LineNumber),
           (SELECT r.OrderId, r.LineNumber, r.ProductId, r.CustomerId, r.Quantity, r.UnitPrice 
            FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),
           SYSUTCDATETIME()
    FROM RankedOrders r
    WHERE r.rn > 1;

    WITH RankedOrders AS (
        SELECT *,
               ROW_NUMBER() OVER (
                   PARTITION BY OrderId, LineNumber 
                   ORDER BY LoadTimestamp DESC
               ) AS rn
        FROM stg.SalesOrder
    )
    DELETE FROM RankedOrders WHERE rn > 1;
END;
GO

2.2 Fact Table Loading Stored Procedure
--------------------------------------------------------------------------------
CREATE OR ALTER PROCEDURE dw.usp_LoadFactSales
AS
BEGIN
    SET NOCOUNT ON;
    BEGIN TRY
        BEGIN TRANSACTION;

        EXEC stg.usp_DeduplicateSalesOrder;[cite: 1]

        INSERT INTO dw.FactSales (
            DateKey, ProductKey, CustomerKey, StoreKey,
            OrderId, LineNumber, Quantity, UnitPrice,
            DiscountAmount, NetAmount, CostAmount, LoadTimestamp
        )
        SELECT
            CONVERT(INT, CONVERT(VARCHAR(8), s.OrderDate, 112)) AS DateKey,
            p.ProductKey,
            c.CustomerKey,
            st.StoreKey,
            s.OrderId,
            s.LineNumber,
            s.Quantity,
            s.UnitPrice,
            ISNULL(s.DiscountAmount, 0),
            (s.Quantity * s.UnitPrice) - ISNULL(s.DiscountAmount, 0) AS NetAmount,
            s.CostAmount,
            SYSUTCDATETIME()
        FROM stg.SalesOrder s
        INNER JOIN dw.DimProduct  p  ON p.ProductId  = s.ProductId  AND p.IsActive = 1
        INNER JOIN dw.DimCustomer c  ON c.CustomerId = s.CustomerId AND c.IsCurrent = 1
        INNER JOIN dw.DimStore    st ON st.StoreId   = s.StoreId
        WHERE NOT EXISTS (
            SELECT 1 FROM dw.FactSales f 
            WHERE f.OrderId = s.OrderId AND f.LineNumber = s.LineNumber
        );

        TRUNCATE TABLE stg.SalesOrder;

        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
        THROW;
    END CATCH
END;
GO

2.3 Watermark Update Stored Procedure
--------------------------------------------------------------------------------
CREATE OR ALTER PROCEDURE meta.usp_UpdateWatermark
    @EntityId INT,
    @NewWatermark NVARCHAR(100)
AS
BEGIN
    SET NOCOUNT ON;
    UPDATE meta.EntityConfig
    SET LastWatermarkValue = CAST(@NewWatermark AS DATETIME2(3))
    WHERE EntityId = @EntityId;
END;
GO


--------------------------------------------------------------------------------
3. AZURE DATA FACTORY ORCHESTRATION PIPELINES
--------------------------------------------------------------------------------

3.1 Master Pipeline: pl_SalesOrchestrator_Main
- Activity 1 (GetActiveEntities - Lookup):
  Source SQL:
  SELECT EntityId, EntityName, EntityType, Priority 
  FROM meta.EntityConfig 
  WHERE IsActive = 1 
  ORDER BY Priority ASC;[cite: 1]

- Activity 2 (ForEachEntity - ForEach):
  Items: @activity('GetActiveEntities').output.value[cite: 1]
  Calls Child Pipeline: PL_Metadata_Driven_Load passing EntityId = @item().EntityId[cite: 1]

3.2 Child Pipeline: PL_Metadata_Driven_Load (Parameterized by EntityId)
1. GetEntityConfig (Lookup):
   Query: @concat('SELECT * FROM meta.EntityConfig WHERE EntityId = ', pipeline().parameters.EntityId)[cite: 1]

2. GetFiles (Get Metadata):
   Dataset: DS_ADLS_Dynamic_Source
   Container: @activity('GetEntityConfig').output.firstRow.SourceContainer[cite: 1]
   Directory: @activity('GetEntityConfig').output.firstRow.SourcePathPattern[cite: 1]
   Argument: Child Items[cite: 1]

3. ForEachFile (ForEach on @activity('GetFiles').output.childItems):
   - CopyFileToStaging (Copy Activity):
     Source Dataset: DS_ADLS_Dynamic_Source (p_FileName = @item().name)
     Sink Dataset: AzureSqlTable1
       p_Schema = @split(activity('GetEntityConfig').output.firstRow.StagingTable, '.')[0]
       p_Table  = @split(activity('GetEntityConfig').output.firstRow.StagingTable, '.')[1]

4. GetNewWatermark (Lookup):
   Query:
   @if(
       empty(activity('GetEntityConfig').output.firstRow.WatermarkColumn),
       'SELECT CONVERT(VARCHAR(30), GETUTCDATE(), 126) AS NewWatermarkValue',
       concat('SELECT CONVERT(VARCHAR(30), ISNULL(MAX(', activity('GetEntityConfig').output.firstRow.WatermarkColumn, '), ''', coalesce(activity('GetEntityConfig').output.firstRow.LastWatermarkValue, '1900-01-01'), '''), 126) AS NewWatermarkValue FROM ', activity('GetEntityConfig').output.firstRow.StagingTable)
   )

5. ExecuteTargetLoadAndDeduplication (Stored Procedure):
   Procedure: dw.usp_LoadFactSales (or entity-mapped load procedure)[cite: 1]

6. UpdateWatermarkValue (Stored Procedure):
   Procedure: meta.usp_UpdateWatermark[cite: 1]
   Parameters:
     EntityId     = @pipeline().parameters.EntityId[cite: 1]
     NewWatermark = @activity('GetNewWatermark').output.firstRow.NewWatermarkValue


